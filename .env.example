# Vapi (scripts only; the service itself never needs the API key)
VAPI_API_KEY=your-vapi-private-key
VAPI_PUBLIC_KEY=your-vapi-public-key          # only for scripts/web_test_call.py

# Shared secret Vapi sends in the x-vapi-secret header on every webhook
VAPI_WEBHOOK_SECRET=make-a-long-random-string

BUSINESS_NAME=Harbour Dental Clinic
BUSINESS_TZ=Europe/London
SLOT_MINUTES=30
MIN_NOTICE_MINUTES=60
DATA_DIR=var

# Calendar: local (SQLite + .ics) or google
CALENDAR_BACKEND=local
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=

# Team email. Leave SMTP_HOST empty and messages go to var/outbox.jsonl instead.
TEAM_EMAIL=frontdesk@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: a real number to transfer callers to after a handover
TRANSFER_NUMBER=
